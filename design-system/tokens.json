{
  "$description": "Trainer Landing — W3C DTCG Design Tokens",
  "color": {
    "navy": {
      "900": { "$value": "#0F2440", "$type": "color" },
      "800": { "$value": "#1B3A5C", "$type": "color" },
      "700": { "$value": "#224878", "$type": "color" }
    },
    "bronze": {
      "600": { "$value": "#B8862E", "$type": "color" },
      "500": { "$value": "#C9973A", "$type": "color" },
      "100": { "$value": "#F5ECD8", "$type": "color" }
    },
    "warm": {
      "50":  { "$value": "#F8F7F4", "$type": "color" },
      "100": { "$value": "#EDEAE4", "$type": "color" },
      "200": { "$value": "#D6D2C8", "$type": "color" }
    },
    "gray": {
      "500": { "$value": "#6B7280", "$type": "color" },
      "900": { "$value": "#141414", "$type": "color" }
    },
    "forest": {
      "700": { "$value": "#2D6A4F", "$type": "color" }
    },
    "white":     { "$value": "#FFFFFF", "$type": "color" },
    "whatsapp":  { "$value": "#25D366", "$type": "color" },
    "red": {
      "600": { "$value": "#DC2626", "$type": "color" }
    }
  },
  "semantic": {
    "background":       { "$value": "{color.warm.50}",   "$type": "color" },
    "foreground":       { "$value": "{color.gray.900}",  "$type": "color" },
    "primary":          { "$value": "{color.navy.800}",  "$type": "color" },
    "primary-hover":    { "$value": "{color.navy.900}",  "$type": "color" },
    "accent":           { "$value": "{color.bronze.600}","$type": "color" },
    "accent-tint":      { "$value": "{color.bronze.100}","$type": "color" },
    "card":             { "$value": "{color.white}",     "$type": "color" },
    "muted":            { "$value": "{color.warm.100}",  "$type": "color" },
    "muted-foreground": { "$value": "{color.gray.500}",  "$type": "color" },
    "border":           { "$value": "{color.warm.200}",  "$type": "color" },
    "success":          { "$value": "{color.forest.700}","$type": "color" },
    "destructive":      { "$value": "{color.red.600}",   "$type": "color" }
  },
  "font": {
    "display": { "$value": "Cairo, 'Noto Sans Arabic', Arial, sans-serif", "$type": "fontFamily" },
    "body":    { "$value": "'IBM Plex Sans Arabic', 'Noto Sans Arabic', Tahoma, sans-serif", "$type": "fontFamily" }
  },
  "spacing": {
    "1":  { "$value": "0.25rem", "$type": "dimension" },
    "2":  { "$value": "0.5rem",  "$type": "dimension" },
    "3":  { "$value": "0.75rem", "$type": "dimension" },
    "4":  { "$value": "1rem",    "$type": "dimension" },
    "6":  { "$value": "1.5rem",  "$type": "dimension" },
    "8":  { "$value": "2rem",    "$type": "dimension" },
    "12": { "$value": "3rem",    "$type": "dimension" },
    "16": { "$value": "4rem",    "$type": "dimension" },
    "24": { "$value": "6rem",    "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "0.25rem", "$type": "dimension" },
    "md":   { "$value": "0.375rem","$type": "dimension" },
    "lg":   { "$value": "0.5rem",  "$type": "dimension" },
    "xl":   { "$value": "0.75rem", "$type": "dimension" },
    "2xl":  { "$value": "1rem",    "$type": "dimension" },
    "full": { "$value": "9999px",  "$type": "dimension" }
  }
}
